const PDF_DIR = path.resolve(process.cwd(), "server", "documents");

function normalizeText(text: string): string {
  return text
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
}

async function searchPdfDocuments(question: string): Promise<string> {
  try {
    const files = await fs.readdir(PDF_DIR);
    const pdfFiles = files.filter((file) =>
      file.toLowerCase().endsWith(".pdf")
    );

    if (pdfFiles.length === 0) {
      return "Chưa có tài liệu PDF để tra cứu.";
    }

    const chunks: { source: string; text: string }[] = [];

    for (const file of pdfFiles) {
      const filePath = path.join(PDF_DIR, file);
      const buffer = await fs.readFile(filePath);
      const parsed = await pdfParse(buffer);

      // Chia văn bản thành các đoạn có phần chồng lặp.
      const text = parsed.text.replace(/\s+/g, " ").trim();
      const chunkSize = 900;
      const overlap = 150;

      for (
        let start = 0;
        start < text.length;
        start += chunkSize - overlap
      ) {
        const chunk = text.slice(start, start + chunkSize).trim();

        if (chunk) {
          chunks.push({ source: file, text: chunk });
        }
      }
    }

    const stopWords = new Set([
      "la", "va", "cua", "cho", "toi", "gi", "nhung",
      "the", "nao", "khi", "can", "co", "duoc", "trong"
    ]);

    const keywords = normalizeText(question)
      .split(/[^a-z0-9]+/)
      .filter((word) => word.length > 1 && !stopWords.has(word));

    const ranked = chunks
      .map((chunk) => {
        const normalizedChunk = normalizeText(chunk.text);
        const score = keywords.reduce(
          (total, word) =>
            total + (normalizedChunk.includes(word) ? 1 : 0),
          0
        );

        return { ...chunk, score };
      })
      .filter((chunk) => chunk.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 4);

    if (ranked.length === 0) {
      return "Không tìm thấy đoạn PDF phù hợp với câu hỏi.";
    }

    return ranked
      .map(
        (chunk, index) =>
          `[Tài liệu: ${chunk.source} | Đoạn ${index + 1}]\n${chunk.text}`
      )
      .join("\n\n");
  } catch (error) {
    console.error("Lỗi đọc PDF:", error);
    return "Không thể đọc tài liệu PDF lúc này.";
  }
}


